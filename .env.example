# Database
DATABASE_URL="file:./dev.db"

# JWT Secrets (generate strong random strings for production)
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"

# Public URL
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Razorpay Payment Integration
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-secret-key"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# Email Service (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@petcompanion.in"

# Branding (Optional - will use defaults if not set)
NEXT_PUBLIC_BRANDING_NAME="PetCompanion India"
NEXT_PUBLIC_SUPPORT_EMAIL="support@petcompanion.in"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"
